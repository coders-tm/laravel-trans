{
    "name": "coderstm/laravel-trans",
    "description": "A complete Laravel translation toolchain — scan, export/import CSV, clean unused keys, and auto-wrap Blade/Vue/JS/PHP content with translation helpers.",
    "keywords": [
        "laravel",
        "translation",
        "i18n",
        "localization",
        "translatable"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Dipak Sarkar",
            "email": "hello@dipaksarkar.in"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/finder": "^7.0|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Trans\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Trans\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/",
            "App\\": "vendor/orchestra/testbench-core/laravel/app/",
            "Database\\Factories\\": "vendor/orchestra/testbench-core/laravel/database/factories/",
            "Database\\Seeders\\": "vendor/orchestra/testbench-core/laravel/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Trans\\LaravelTransServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/testbench package:test --ansi"
        ],
        "format": [
            "@php vendor/bin/pint --ansi"
        ],
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}