{
    "name": "nitro/laravel-trans",
    "description": "A complete Laravel translation toolchain — scan, export/import CSV, clean unused keys, and auto-wrap Blade/Vue/JS/PHP content with translation helpers.",
    "keywords": ["laravel", "translation", "i18n", "localization", "translatable"],
    "license": "MIT",
    "authors": [
        {
            "name": "NitroFIT",
            "email": "hello@nitrofit.co.uk"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "symfony/finder": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Nitro\\Trans\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nitro\\Trans\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nitro\\Trans\\LaravelTransServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
